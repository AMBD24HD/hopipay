rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Currencies (Dollar Buy/Sell exchange rates, deposit wallets, reserves)
    match /currencies/{currencyId} {
      allow read, write: if true;
    }

    // 2. Settings (Notice banner, online status, site logo, site favicon, bKash & Nagad numbers & logos)
    match /settings/{settingId} {
      allow read, write: if true;
    }

    // 3. Orders (Buy/Sell dollar transactions)
    match /orders/{orderId} {
      allow read, write: if true;
    }

    // 4. User Profiles
    match /users/{userId} {
      allow read, write: if true;
    }

    // 5. Live Support Chat Messages
    match /chats/{chatId} {
      allow read, write: if true;
    }

    // Fallback: Default allow read and write
    match /{document=**} {
      allow read, write: if true;
    }
  }
}

